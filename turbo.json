{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV", "MONGODB_URI", "JWT_SECRET", "R2_*", "RESEND_API_KEY", "STRIPE_*"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "dist/**",
        "build/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "clean": {
      "cache": false
    }
  }
}